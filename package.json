{
  "name": "ticket-sweeper",
  "version": "1.0.0",
  "description": "Local ticket availability monitor with Puppeteer, LINE/Telegram notifications, and Web UI",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "start:all": "concurrently \"npm run start\" \"cd ocr-server && python main.py\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "tixcraft",
    "ticket",
    "puppeteer",
    "scraper"
  ],
  "license": "MIT",
  "dependencies": {
    "@line/bot-sdk": "^11.0.1",
    "@ngrok/ngrok": "^1.7.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "puppeteer-real-browser": "^1.3.18"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
